# Copy to .env.local for development. These values are compiled into the app and visible to anyone,
# so never put secrets here (the session secret lives only in the worker).

# URL of the API worker. Local: http://localhost:8787 (npm run dev in worker/).
# Production: https://rudrabeads-api.<your-subdomain>.workers.dev or your custom domain.
EXPO_PUBLIC_API_URL=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type "Web application").
# Must be the same value as GOOGLE_CLIENT_ID in worker/wrangler.jsonc.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
